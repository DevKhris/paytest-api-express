NODE_ENV=development
PORT=3000

# Database - usa DATABASE_URL para Supabase (requerido)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Database - alternativa con variables individuales (para desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=password
DB_NAME=paytest

# JWT
JWT_SECRET=jwt-secret-key-change-in-prod
JWT_EXPIRES_IN=86400
